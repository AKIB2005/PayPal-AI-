# --- AI: mock | claude | gemini  (mock needs no key) ---
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- PayPal: mock | sandbox ---
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the PayPal Developer Dashboard (NOT the client id)
PAYPAL_WEBHOOK_ID=
# Sandbox personal account email that receives the seeded invoices
PAYPAL_TEST_PAYER_EMAIL=
# Optional: only for local testing without a registered webhook
ALLOW_UNVERIFIED_WEBHOOKS=0

# --- App ---
PORT=3001
SENDER_NAME=Your Name
# Demo date override (YYYY-MM-DD). Sandbox invoices can't be created in the past.
DEMO_DATE=
# Set to off to hide the "simulate client paying" button
DEMO_TOOLS=on
